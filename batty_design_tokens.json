  "handoffGuidance": {
    "status": "Recommendations, not source-authored rules",
    "rules": [
      "Use semantic color tokens in UI; use palette values only to define or extend semantic tokens.",
      "Keep tokens with different meanings separate even when their current values match.",
      "Use composite typography tokens rather than independently mixing their properties.",
      "Do not infer a light theme: only dark colors are present.",
      "Do not invent Android component typography: only core typography has an Android mode.",
      "Do not interpret fontStyle as numeric fontWeight without checking the actual font face.",
      "Confirm lineHeight and letterSpacing units before implementation.",
      "Preserve translucent colors instead of flattening them against one assumed background."
    ]
  },
